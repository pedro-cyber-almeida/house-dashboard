# House Dashboard — environment variables (all optional for local dev)

# Session-cookie signing key. If omitted, one is generated in the data
# directory (.secret) and persisted, so sessions survive restarts.
# DASH_SECRET_KEY=

# Displayed application name (top bar, login screen, browser tab).
DASH_APP_NAME=House Dashboard

# Path to the SQLite database. Default: data/dashboard.db
# DASH_DB_PATH=

# Directory holding the DB and the generated .secret key. In Docker the
# Dockerfile already sets DASH_DATA_DIR=/data (volume `dashboard_data`).
# DASH_DATA_DIR=

# First-admin bootstrap (created on the very first startup, if missing)
DASH_ADMIN_USERNAME=admin
DASH_ADMIN_PASSWORD=

# Connection (production, behind a reverse proxy)
# DASH_HOST=127.0.0.1
# DASH_PORT=8000

# Host-side port published by docker-compose (left side of ":8000").
#   Production, behind a TLS reverse proxy:  DASH_BIND=127.0.0.1:8090
#   Local browser dev:                       DASH_BIND=127.0.0.1:8000
# Defaults to 127.0.0.1:8090 when omitted.
# The reverse-proxy upstream must point at the port chosen here.
# DASH_BIND=127.0.0.1:8090

# Secure cookie: disabled automatically for local http (127.0.0.1/localhost).
# Force it behind HTTPS: DASH_COOKIE_SECURE=true
# DASH_COOKIE_SECURE=true

# Session lifetime, in seconds. Default: 43200 (12 h)
# DASH_COOKIE_MAX_AGE=43200
